# Identifiants de l'appli (Partner Dashboard › Applis › Factures PDF › Identifiants client)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# URL publique HTTPS du serveur (identique à application_url dans shopify.app.toml)
SHOPIFY_APP_URL=https://factures.exemple.fr
SHOPIFY_API_VERSION=2026-10

PORT=3000
DATABASE_PATH=./data/factures.sqlite

# Envoi des e-mails : n'importe quel fournisseur SMTP (Brevo, Mailjet, Postmark, OVH…).
# Exemple Brevo : Paramètres › SMTP et API › SMTP (identifiant et clé SMTP, pas le mot de passe du compte).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse d'expédition : doit être validée chez le fournisseur (expéditeur ou domaine authentifié).
MAIL_FROM=factures@votre-domaine.fr
# (Alternative en une ligne : SMTP_URL=smtp://utilisateur:motdepasse@hote:587, « @ » encodé en %40.)

# Abonnements de test (aucun prélèvement réel). Mettre false en production.
BILLING_TEST=true

# Adresse du support affichée dans la FAQ (sinon la question « Comment contacter le support ? » est masquée)
SUPPORT_EMAIL=support@votre-domaine.fr

# Chiffrement au repos des données personnelles (npm run key). À garder aussi hors ligne :
# sans cette clé, la base et les sauvegardes sont illisibles.
DATA_ENCRYPTION_KEY=
# Sauvegardes automatiques chiffrées : un dossier sur un AUTRE disque/volume que la base.
BACKUP_DIR=/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
# Clé distincte pour les sauvegardes (facultatif, sinon DATA_ENCRYPTION_KEY)
BACKUP_ENCRYPTION_KEY=
