{
  "name": "hoshi-factures-pdf",
  "version": "0.1.0",
  "private": true,
  "description": "Appli Shopify : facture PDF générée à chaque commande et envoyée par e-mail au client.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.js'",
    "preview": "node --disable-warning=ExperimentalWarning scripts/preview.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2"
  }
}
