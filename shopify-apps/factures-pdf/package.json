{
  "name": "hoshi-factures-pdf",
  "version": "0.1.0",
  "private": true,
  "description": "Appli Shopify : facture PDF générée à chaque commande et envoyée par e-mail au client.",
  "type": "module",
  "main": "src/index.js",
  "workspaces": [
    "extensions/*"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "preview": "node --disable-warning=ExperimentalWarning scripts/preview.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.js",
    "screenshots": "node --disable-warning=ExperimentalWarning scripts/screenshots.js",
    "site": "node --disable-warning=ExperimentalWarning scripts/build-site.js",
    "key": "node scripts/key.js",
    "test:worker": "node --disable-warning=ExperimentalWarning scripts/test-worker.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "backup": "node --disable-warning=ExperimentalWarning scripts/backup.js",
    "restore": "node --disable-warning=ExperimentalWarning scripts/restore.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.16",
    "nodemailer": "^10.3.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "wrangler": "^4.156.1"
  }
}
