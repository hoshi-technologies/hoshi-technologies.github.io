{%- comment -%}
  Intégration d'application : bouton flottant + panneau de fidélité.
  À activer dans Éditeur de thème > Intégrations d'applications.
  Le widget s'affiche dans la langue de la boutique vue par le client.
{%- endcomment -%}
<div
  id="hoshi-loyalty"
  class="hoshi-loyalty"
  data-hoshi-locale="{{ request.locale.iso_code }}"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-first-name="{{ customer.first_name | escape }}"
  data-login-url="{{ routes.account_login_url }}"
  data-register-url="{{ routes.account_register_url }}"
  data-position="{{ block.settings.position }}"
  data-label="{{ block.settings.label | escape }}"
  data-guest-text="{{ block.settings.guest_text | escape }}"
></div>
<script src="{{ 'loyalty.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'loyalty.css' | asset_url }}" media="print" onload="this.media='all'">

{% schema %}
{
  "name": "Hoshi Club",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label.label",
      "info": "t:settings.label.info"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:settings.position.label",
      "options": [
        { "value": "app", "label": "t:settings.position.app" },
        { "value": "right", "label": "t:settings.position.right" },
        { "value": "left", "label": "t:settings.position.left" }
      ],
      "default": "app"
    },
    {
      "type": "textarea",
      "id": "guest_text",
      "label": "t:settings.guest_text.label",
      "info": "t:settings.guest_text.info"
    }
  ]
}
{% endschema %}
