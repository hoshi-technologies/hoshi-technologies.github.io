{%- comment -%}
  Bloc d'application : carte « Mes points » à placer dans une page
  (ex. page Fidélité / Club ou page compte). Utilise la même API que le widget.
{%- endcomment -%}
<div
  class="hoshi-loyalty-card"
  data-hoshi-card
  data-hoshi-locale="{{ request.locale.iso_code }}"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  data-login-url="{{ routes.account_login_url }}"
  data-register-url="{{ routes.account_register_url }}"
  data-heading="{{ block.settings.heading | escape }}"
  style="--hl-max-width: {{ block.settings.max_width }}px"
></div>
<script src="{{ 'loyalty.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'loyalty.css' | asset_url }}">

{% schema %}
{
  "name": "t:card.name",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:card.heading" },
    { "type": "range", "id": "max_width", "label": "t:card.max_width", "min": 320, "max": 1200, "step": 20, "unit": "px", "default": 720 }
  ]
}
{% endschema %}
