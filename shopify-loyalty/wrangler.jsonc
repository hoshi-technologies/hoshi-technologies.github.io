// Configuration Cloudflare Workers de « Hoshi Club »
// Documentation : https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoshi-club",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Base de données (créée avec : npx wrangler d1 create hoshi-club)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoshi-club",
      "database_id": "REMPLACER_PAR_L_ID_DE_LA_BASE_D1",
      "migrations_dir": "migrations"
    }
  ],

  // Tâche horaire : anniversaires et expiration des points
  "triggers": { "crons": ["7 * * * *"] },

  // Variables non secrètes. Les secrets (SHOPIFY_API_SECRET) se définissent avec :
  //   npx wrangler secret put SHOPIFY_API_SECRET
  "vars": {
    "SHOPIFY_API_KEY": "REMPLACER_PAR_LE_CLIENT_ID",
    "SHOPIFY_APP_URL": "https://hoshi-club.example.com",
    "SHOPIFY_APP_HANDLE": "hoshi-club",
    "SCOPES": "write_customers,read_orders,write_discounts",
    "BILLING_REQUIRED": "true",
    "SUPPORT_EMAIL": "hoshi.technologies@gmail.com"
  }

  // Domaine personnalisé sur votre zone Cloudflare (décommentez et adaptez) :
  // "routes": [{ "pattern": "hoshi-club.example.com", "custom_domain": true }]
}
