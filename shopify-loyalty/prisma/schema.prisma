// Client généré pour Cloudflare Workers (sans moteur natif)
generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  runtime         = "cloudflare"
  moduleFormat    = "esm"
  engineType      = "client"
}

// Base Cloudflare D1 (SQLite). Les migrations SQL sont dans /migrations
// et s'appliquent avec : npm run db:migrate:local / db:migrate:remote
datasource db {
  provider = "sqlite"
  url      = "file:./dev.sqlite"
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Réglages du programme de fidélité (un par boutique)
model Program {
  shop           String   @id
  enabled        Boolean  @default(true)
  pointsName     String   @default("points")
  pointsPerUnit  Float    @default(1)    // points gagnés par unité de devise dépensée
  signupPoints   Int      @default(100)  // bonus à l'inscription
  firstOrderPoints Int    @default(0)    // bonus sur la première commande
  widgetTitle    String   @default("Mes récompenses")
  widgetColor    String   @default("#5C6AC4")
  widgetPosition String   @default("right") // right | left

  // Anniversaire
  birthdayPoints   Int      @default(200)

  // Parrainage
  referralEnabled     Boolean @default(true)
  referrerPoints      Int     @default(500)     // gagnés par le parrain à la 1re commande du filleul
  friendRewardType    String  @default("AMOUNT") // AMOUNT | PERCENT | FREE_SHIPPING
  friendRewardValue   Float   @default(10)
  friendMinSubtotal   Float?

  // Réseaux sociaux (points gagnés une fois par réseau)
  socialPoints   Int     @default(50)
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?

  // Campagne de points bonus (ex. points x2)
  bonusMultiplier Float     @default(1)
  bonusStartsAt   DateTime?
  bonusEndsAt     DateTime?
  bonusLabel      String?

  // Expiration des points après N mois sans activité (0 = jamais)
  expirationMonths Int @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Récompense échangeable contre des points
model Reward {
  id          String       @id @default(cuid())
  shop        String
  title       String
  type        String       // AMOUNT | PERCENT | FREE_SHIPPING
  value       Float        @default(0)
  pointsCost  Int
  minSubtotal Float?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  redemptions Redemption[]

  @@index([shop])
}

/// Niveau client (Bronze, Argent, Or, Ambassadrice...)
/// - AUTO   : atteint automatiquement selon les points cumulés
/// - MANUAL : attribué uniquement par le marchand
model Tier {
  id                  String   @id @default(cuid())
  shop                String
  name                String
  mode                String   @default("AUTO") // AUTO | MANUAL
  minPoints           Int      @default(0)      // points cumulés (niveaux AUTO)
  multiplier          Float    @default(1)
  color               String   @default("#B08D57")

  // Avantages appliqués automatiquement au paiement
  discountType        String   @default("NONE") // NONE | PERCENT | AMOUNT
  discountValue       Float    @default(0)
  discountMinSubtotal Float?
  freeShipping        Boolean  @default(false)
  perks               String?  // autres avantages (texte affiché au client)

  // Synchronisation Shopify
  tag                 String?  // étiquette client, ex. « Fidélité Or »
  segmentId           String?
  discountId          String?
  shippingDiscountId  String?
  syncError           String?

  members             Member[]

  @@index([shop])
}

/// Client membre du programme
model Member {
  id             String        @id @default(cuid())
  shop           String
  customerId     String        // GID Shopify : gid://shopify/Customer/123
  email          String?
  firstName      String?
  lastName       String?
  points         Int           @default(0)
  lifetimePoints Int           @default(0)
  ordersCount    Int           @default(0)
  manualTierId   String?       // niveau imposé par le marchand (sinon calculé)
  manualTier     Tier?         @relation(fields: [manualTierId], references: [id], onDelete: SetNull)
  appliedTag     String?       // étiquette de niveau actuellement posée sur le client Shopify
  birthday       String?       // « MM-JJ »
  birthdaySetAt  DateTime?
  referralCode   String?       // code de parrainage personnel
  lastActivityAt DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[]
  redemptions    Redemption[]
  referrals      Referral[]

  @@unique([shop, customerId])
  @@unique([shop, referralCode])
  @@index([shop, points])
}

/// Historique des mouvements de points
model Transaction {
  id          String   @id @default(cuid())
  shop        String
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  points      Int      // positif = gain, négatif = dépense/retrait
  type        String   // SIGNUP | ORDER | FIRST_ORDER | REDEEM | REFUND | ADJUST
  description String
  reference   String?  // identifiant unique (commande, remboursement) pour éviter les doublons
  createdAt   DateTime @default(now())

  @@unique([shop, type, reference])
  @@index([shop, createdAt])
  @@index([memberId, createdAt])
}

/// Code de réduction généré lors d'un échange de points
model Redemption {
  id         String   @id @default(cuid())
  shop       String
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  rewardId   String?
  reward     Reward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  title      String
  code       String
  discountId String?
  pointsCost Int
  createdAt  DateTime @default(now())
  usedAt     DateTime? // renseigné quand le code est utilisé dans une commande
  orderId    String?
  orderTotal Float?

  @@unique([shop, code])
  @@index([shop, createdAt])
  @@index([memberId])
}

/// Parrainage : un ami invité par un membre reçoit un code de bienvenue
model Referral {
  id          String    @id @default(cuid())
  shop        String
  referrerId  String
  referrer    Member    @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  friendEmail String
  code        String    // code de réduction offert à l'ami
  discountId  String?
  status      String    @default("PENDING") // PENDING | COMPLETED
  orderId     String?
  orderTotal  Float?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([shop, friendEmail])
  @@unique([shop, code])
  @@index([referrerId])
}
